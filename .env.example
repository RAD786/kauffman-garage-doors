# Copy to .env.local and fill in. None of these are required for the site to
# build or run -- without them, submitted leads are logged to the server console
# only. Wire at least one delivery method before going live.

# Canonical site origin, no trailing slash.
NEXT_PUBLIC_SITE_URL=https://kauffmangarage.com

# --- Lead delivery: option A, Resend (https://resend.com) ---
# Simplest route. Free tier covers a small shop's volume.
# The "from" address must be on a domain you've verified in Resend.
RESEND_API_KEY=
LEAD_EMAIL_FROM=leads@kauffmangarage.com
LEAD_EMAIL_TO=rdkkauffman@gmail.com

# --- Lead delivery: option B, generic webhook ---
# Any endpoint that accepts a JSON POST: Zapier, Make, n8n, a CRM, Google Sheets.
# Fires in addition to email if both are set.
LEAD_WEBHOOK_URL=

# --- Analytics / verification (optional) ---
# Value only, not the full meta tag.
GOOGLE_SITE_VERIFICATION=
